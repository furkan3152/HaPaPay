OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
APP_URL=http://localhost:5173
APP_DOMAIN=localhost
# In production, your own origin: APP_URL=https://your-domain.example and APP_DOMAIN=your-domain.example.
# Register OAuth redirects at https://your-domain.example/api/oauth/{github,x,discord}/callback.
# Signs wallet sessions. Generate your own for production (openssl rand -hex 32); production refuses this placeholder.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional in development. Required in production.
DATABASE_URL=

# Official social login credentials. Never prefix these with VITE_.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_API_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_API_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optimism RPC for Sign in with Farcaster smart-account verification. Required in production.
FARCASTER_OPTIMISM_RPC_URL=

# One sign-in for every network (Privy): the app ID from the Privy dashboard, which is public. Allow the site's origin
# there. Without it the desk uses the browser's own EVM and Solana wallets.
PRIVY_APP_ID=

# Solana mainnet. The cluster is fixed in code; SOLANA_RPC_URL can only point the server at an HTTPS
# provider (QuickNode; it may carry a key, never sent to the browser) and defaults to https://api.mainnet-beta.solana.com.
SOLANA_RPC_URL=
# The pages' Solana RPC: a separate QuickNode Solana mainnet endpoint (https://<name>.solana-mainnet.quiknode.pro/<token>/)
# whose endpoint security allows only the site's domain as a referrer. Its token is sent to every page, because
# Solana's public RPC refuses browsers; xStocks, Privy's Solana wallets and the vault deployment need it.
SOLANA_BROWSER_RPC_URL=
# The 1% fee on Solana goes here, all of it. Solana payments stay off without it.
SOLANA_TREASURY_ADDRESS=
# USDC and USDG run unless set to "disabled"; xStocks stay off until set to "enabled" after reviewing eligibility.
SOLANA_TRANSFERS=
SOLANA_STOCK_TRANSFERS=
# The Solana vault: the operator's Solana address (added to their HaPaPay account) deploys the program from
# /operator/stock-escrow, and a new key just for claims signs them (npm run init:solana-attestor, outside any chat).
# The server refuses an attestor that is the operator's or the treasury's key.
SOLANA_OPERATOR_ADDRESS=
SOLANA_CLAIM_ATTESTOR_PRIVATE_KEY=

# Robinhood Chain stock-token transfers. Wallets sign every transfer; these settings only choose where the
# server prepares and verifies them. Testnet faucet tokens run unless set to "disabled". Mainnet moves real
# Stock Tokens and stays off until set to "enabled" after reviewing eligibility for your users.
ROBINHOOD_TESTNET_STOCK_TRANSFERS=
ROBINHOOD_MAINNET_STOCK_TRANSFERS=
# USDG is not a Stock Token: it runs unless set to "disabled", with no eligibility statement.
ROBINHOOD_TESTNET_TOKEN_TRANSFERS=
ROBINHOOD_MAINNET_TOKEN_TRANSFERS=
# Optional server-side HTTPS RPC overrides, such as a QuickNode endpoint (may carry a provider key; never sent to the
# browser; the public RPC takes over when it fails).
# Defaults: https://rpc.testnet.chain.robinhood.com and https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_MAINNET_RPC_URL=
# Vault links: Stock Tokens or USDG for a GitHub, X, Farcaster, Discord or Telegram account that has not joined yet wait in
# StockClaimEscrow. With X_API_BEARER_TOKEN an X link waits for the account; without it, for the name. Farcaster names
# resolve through the public fname registry.
# The Robinhood operator wallet deploys the burn vault, the 1% fee router and the escrow from /operator/stock-escrow
# and the server registers them after checking them on chain, so no contract address is configured here. That
# wallet owns them and receives the treasury half of each fee; without ROBINHOOD_OPERATOR_ADDRESS the server uses
# CONTRACT_OWNER_ADDRESS, which stays the Arc Testnet contracts' owner either way. Testnet may reuse
# CLAIM_ATTESTOR_PRIVATE_KEY (the Arc Testnet claim attestor); mainnet needs its own key, and a key used by any other
# role is refused.
ROBINHOOD_OPERATOR_ADDRESS=
ROBINHOOD_TESTNET_CLAIM_ATTESTOR_PRIVATE_KEY=
ROBINHOOD_MAINNET_CLAIM_ATTESTOR_PRIVATE_KEY=

# Arc network for USDC payments: testnet or mainnet. Mainnet uses the bundled official parameters (RPC
# https://rpc.mainnet.arc.io, chain ID 5042, explorer https://explorer.arc.io, ERC-20 USDC
# 0x3600000000000000000000000000000000000000 with 6 decimals). ARC_MAINNET_RPC_URL may name a provider's HTTPS
# endpoint (QuickNode) for the server's own reads: it may carry a key, is never sent to a browser, must report chain ID
# 5042, and the official endpoints take over when it fails; wallets keep the official RPC. The other ARC_MAINNET_*
# overrides are optional and must name exactly those values.
ARC_NETWORK_MODE=testnet
ARC_MAINNET_RPC_URL=
ARC_MAINNET_CHAIN_ID=
ARC_MAINNET_EXPLORER_URL=
ARC_MAINNET_USDC_ADDRESS=

# Arc Testnet contracts (revision 2 registry; the escrow must be the reviewed StockClaimEscrow with its fee router).
ARC_IDENTITY_REGISTRY_ADDRESS=
ARC_CLAIM_ESCROW_ADDRESS=
CLAIM_ATTESTOR_PRIVATE_KEY=
CONTRACT_OWNER_ADDRESS=
IDENTITY_ATTESTOR_PRIVATE_KEY=

# Arc Mainnet has its own names, so its keys and addresses never replace the testnet ones. Make both attestor keys
# just for this (0x and 64 hex characters, outside any chat), deploy the four contracts from /operator/stock-escrow
# with the operator wallet (ARC_MAINNET_OPERATOR_ADDRESS, else ROBINHOOD_OPERATOR_ADDRESS), then set the two
# addresses and ARC_NETWORK_MODE=mainnet. The whole Arc fee goes to the operator wallet.
ARC_MAINNET_IDENTITY_ATTESTOR_PRIVATE_KEY=
ARC_MAINNET_CLAIM_ATTESTOR_PRIVATE_KEY=
ARC_MAINNET_IDENTITY_REGISTRY_ADDRESS=
ARC_MAINNET_CLAIM_ESCROW_ADDRESS=
ARC_MAINNET_OPERATOR_ADDRESS=

# SP and the admin panel (/admin). Admins are these wallets (EVM addresses separated by commas) plus the operator
# wallets above; each admin change is signed by the admin's wallet and kept in the audit log.
ADMIN_WALLET_ADDRESSES=
# Optional: any long random value. Vercel Cron sends it to /api/cron/sp-sync once a day to award every account's
# missing SP. Without it the route stays closed, and SP are awarded when people open the desk or an admin runs it.
CRON_SECRET=

# Docker or another self-hosted setup behind a reverse proxy: the proxies to trust for the client's address, as a hop
# count (1) or their addresses (IPs, CIDR ranges no broader than /8 or /16 for IPv6, or loopback, linklocal and
# uniquelocal). Rate limits count clients by it. Never true. Ignored on Vercel.
TRUST_PROXY=
