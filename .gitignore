# Dependencies and build output
node_modules/
dist/
# npm run build:vercel copies the Vite build into public/index.html and public/assets/ for Vercel's CDN. They are
# not listed here on purpose: Vercel's build skips gitignored files when it collects public/**, so the site would 404.
# Do not commit them; they are build output (git clean -fd public removes them).
*.tsbuildinfo
npm-debug.log*

# Contract and program build output
foundry-out/
foundry-cache/
deployments/
target/

# Local tooling state
.playwright-cli/
output/playwright/
.vercel

# Credentials stay local. Keep the documented template tracked.
.env
.env.*
*.env
!.env.example
.secrets/
.npmrc
*.pem
*.key
*.secret
# Solana keypairs (program and wallet keys)
*-keypair.json
*keypair*.json
id.json
